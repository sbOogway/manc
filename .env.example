# Copy to .env (scripts/install.sh does it) and fill in what you use; empty values are fine.
# Provider keys for the fallback model and any keyed model in config/llm.yaml.
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_BASE=
# Address the API container listens on: loopback, or the LAN address your tunnel machine reaches.
MANC_API_BIND=127.0.0.1
# Model for runs inside the container (no Claude CLI there); host runs use config/llm.yaml.
# MANC_LLM_MODEL=mistral/ministral-14b-latest
