# Copy to .env next to compose.yaml. Read by the api and cron containers, and by compose for
# the port below.
# The port the dashboard is published on (the tunnel points at it); the API is not published.
MANC_PORT=8080
# The tagging model: the default, claude_code/opus, uses the Claude Code login in the claude
# volume (`docker compose run --rm api claude`, then /login, once). A keyed model instead:
# MANC_LLM_MODEL=mistral/ministral-14b-latest
# Provider keys for the fallback model and any keyed model in config/llm.yaml; empty is fine.
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_BASE=
