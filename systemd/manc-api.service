# The REST API container, rootless podman as the manc user. A user unit of manc, installed and
# enabled by scripts/install.sh (linger keeps it up without a session).
[Unit]
Description=manc REST API (podman compose)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/manc
ExecStart=/usr/bin/podman compose up api
ExecStop=/usr/bin/podman compose down
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
