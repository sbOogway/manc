# /etc/manc/env: read by every manc unit (root:manc 0640). Written by `manc install` when
# missing, never overwritten; restart manc-api after editing.
# Provider keys for the fallback model and any keyed model in config/llm.yaml; empty is fine.
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_BASE=
# The database, shared by the API, the fetch timer (user manc) and the daily run (the owner).
MANC_DB_URL=sqlite:////var/lib/manc/manc.db
# Address the API listens on, one of THIS machine's own (`ip -br addr`): loopback when
# cloudflared runs here, else this machine's LAN address, which the tunnel machine then
# points at. Never the tunnel machine's address: the bind fails with EADDRNOTAVAIL.
MANC_API_HOST=127.0.0.1
MANC_API_PORT=8888
# Where the daily run mails the day's reports (through the machine's own `mail`); empty: no mail.
MANC_MAIL_TO=
