# /etc/manc/env: read by every manc unit (root:manc 0640). Written by `manc install` when
# missing, never overwritten; restart manc-api after editing.
# Provider keys for the fallback model and any keyed model in config/llm.yaml; empty is fine.
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_BASE=
# The database, shared by the API, the fetch timer (user manc) and the daily run (the owner).
MANC_DB_URL=sqlite:////var/lib/manc/manc.db
# Address the API listens on: loopback, or the LAN address your tunnel machine reaches.
MANC_API_HOST=127.0.0.1
MANC_API_PORT=8888
# The daily report by email, sent by manc run when MANC_MAIL_TO is set (leave it empty for none).
# Plain SMTP with STARTTLS; MANC_MAIL_FROM defaults to the user; for Gmail use an app password.
MANC_MAIL_TO=
MANC_MAIL_FROM=
MANC_SMTP_HOST=
MANC_SMTP_PORT=587
MANC_SMTP_USER=
MANC_SMTP_PASSWORD=
