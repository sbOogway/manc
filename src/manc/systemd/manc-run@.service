# The daily run as the owner (the instance name, e.g. manc-run@mattia.service), whose Claude
# Code login tags the headlines; group manc and the umask keep the database writable by the
# API and the fetch. The site is published by the owner's post-merge hook, not here.
[Unit]
Description=manc daily run as %i (host, Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
Group=manc
UMask=0002
WorkingDirectory=/var/lib/manc
EnvironmentFile=/etc/manc/env
Environment=PATH=/home/%i/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env manc run
TimeoutStartSec=2h
